<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Image Gallery</title>
  <style>
    body { background-color: #fafafa; font-family: sans-serif; }
    .gallery { border: 1px solid #ccc; float: left; width: 220px; margin: 10px; }
    .gallery img { width: 100%; height: auto; }
    .gallery:hover { border-color: #555; }
    .desc { padding: 10px; text-align: center; }
    h1 { text-align: center; }
  </style>
</head>
<body>
  <h1>My Image Gallery</h1>
  <div class="gallery">
    <img src="https://via.placeholder.com/200" alt="Sample 1">
    <div class="desc">Image 1 Description</div>
  </div>
  <div class="gallery">
    <img src="https://via.placeholder.com/200" alt="Sample 2">
    <div class="desc">Image 2 Description</div>
  </div>
  <div class="gallery">
    <img src="https://via.placeholder.com/200" alt="Sample 3">
    <div class="desc">Image 3 Description</div>
  </div>
</body>
</html>
